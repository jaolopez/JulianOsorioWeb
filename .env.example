# Sanity — proyecto "julian-osorio" (plan gratuito).
# projectId y dataset son públicos por diseño (viajan al navegador).
# Copiá este archivo como .env.local y completá los valores.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Firma del webhook de Sanity → /api/revalidate. Una cadena larga al azar,
# la misma que se pega en sanity.io/manage → API → Webhooks.
SANITY_REVALIDATE_SECRET=

# Dirección pública del sitio (para el mapa del sitio y las vistas previas).
NEXT_PUBLIC_SITE_URL=https://www.julianosoriomusic.com
